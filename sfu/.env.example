# QDTU mediasoup SFU production example
SFU_HTTP_PORT=3010
SFU_RTC_PORT=40000
SFU_WORKERS=1
SFU_ANNOUNCED_IP=YOUR_PUBLIC_IPV4
SFU_LOG_LEVEL=warn
WEB_ORIGIN=https://masofaviy-edu.onrender.com

# Must be the same value on the web app and SFU. Use a long random value.
RTC_TOKEN_SECRET=CHANGE_TO_LONG_RANDOM_SECRET

# Optional on the main web app (not the SFU) for restrictive networks:
# TURN_URLS=turn:turn.example.com:3478?transport=udp;turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=...
# TURN_CREDENTIAL=...
