NODE_ENV=production
PORT=10000
APP_NAME=QDTU Masofaviy Ta'lim
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-immediately
MONGODB_URI=
DB_NAME=masofaviy
RTC_BRIDGE_URL=https://rtc.hallaym.com
RTC_TOKEN_SECRET=
SESSION_DAYS=180
RECORDINGS_DIR=/home/hallaym/masofaviy/storage/recordings
PROCTOR_AI_ENDPOINT=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

EXPRESSTURN_SECRET_KEY=
TURN_TTL_SECONDS=21600
TURN_MAX_URLS=8
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=

# VM 559 / legal-compliance runtime
# Production server must be physically located in Uzbekistan.
SERVER_COUNTRY=UZ
# owned | lease
SERVER_OWNERSHIP=owned
# Required only when SERVER_OWNERSHIP=lease. Contract term must be at least 5 years.
SERVER_LEASE_YEARS=5
DEPLOYMENT_MODE=production

# SCORM 1.2 / 2004 package storage
SCORM_STORAGE_DIR=/home/hallaym/masofaviy/storage/scorm
SCORM_MAX_MB=80
SCORM_EXTRACT_MAX_MB=300

# Audit/proctoring retention
AUDIT_RETENTION_DAYS=730
PROCTOR_RETENTION_DAYS=180

# Official Ministry/HEMIS integration. Obtain these from the authorized system owner.
HEMIS_API_URL=
HEMIS_API_TOKEN=
HEMIS_SYNC_PATH=/lms/sync

# Optional advanced proctoring service for identity/gaze/audio/video analysis.
PROCTOR_AI_ENDPOINT=
