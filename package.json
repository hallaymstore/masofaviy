{
  "name": "qdtuedu-masofaviy",
  "version": "5.0.0",
  "private": true,
  "description": "Qarshi davlat texnika universiteti masofaviy ta'lim platformasi",
  "main": "server-v2.js",
  "scripts": {
    "start": "node -r ./rtc-session-runtime.js -r ./ai-inclusive-runtime.js -r ./ai-extra-runtime.js -r ./lesson-status-runtime.js -r ./compliance-runtime.js -r ./recording-runtime.js server-v2.js",
    "dev": "node --watch -r ./rtc-session-runtime.js -r ./ai-inclusive-runtime.js -r ./lesson-status-runtime.js -r ./compliance-runtime.js -r ./recording-runtime.js server-v2.js",
    "build:rtc": "mkdir -p public/vendor && esbuild rtc-client-entry.js --bundle --minify --platform=browser --format=iife --outfile=public/vendor/mediasoup-client.js",
    "postinstall": "npm run build:rtc"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "esbuild": "^0.25.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.10.0",
    "mediasoup-client": "^3.18.7",
    "mongodb": "^6.20.0",
    "multer": "^2.0.2",
    "sanitize-html": "^2.17.0",
    "socket.io": "^4.8.1",
    "xlsx": "^0.18.5"
  }
}
